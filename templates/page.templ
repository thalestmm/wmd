package templates

import "html/template"

templ Page(content template.HTML) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>wmd - Preview</title>
			<link rel="stylesheet" href="https://latex.now.sh/style.css"/>
			<script>
				MathJax = {
					tex: {
						inlineMath: [['$', '$'], ['\\(', '\\)']],
						displayMath: [['$$', '$$'], ['\\[', '\\]']],
						processEscapes: true
					}
				};
			</script>
			<script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
			<style>
				html, body {
					margin: 0;
					padding: 0;
					background: #404040;
					min-height: 100vh;
				}
				body.libertinus {
					max-width: none;
					padding: 2.5rem 0;
					display: flex;
					flex-direction: column;
					align-items: center;
				}
				main {
					background: #fff;
					width: 210mm;
					min-height: 297mm;
					padding: 25mm 20mm;
					box-sizing: border-box;
					box-shadow: 0 4px 20px rgba(0,0,0,0.5), 0 1px 4px rgba(0,0,0,0.3);
					border: 1px solid #222;
					margin: 0 auto;
					font-size: 11pt;
					line-height: 1.6;
				}
				main p {
					text-align: justify;
				}
				#download-pdf {
					position: fixed;
					top: 1rem;
					right: 1rem;
					padding: 0.45rem 1rem;
					background: #1a73e8;
					color: #fff;
					border: none;
					border-radius: 4px;
					font-size: 0.82rem;
					font-family: sans-serif;
					cursor: pointer;
					box-shadow: 0 2px 8px rgba(0,0,0,0.35);
					z-index: 1000;
					transition: background 0.15s;
				}
				#download-pdf:hover  { background: #1558b0; }
				#download-pdf:disabled { background: #777; cursor: wait; }
				@page {
					margin: 20mm;
				}
				@media print {
					html, body {
						background: white !important;
					}
					body.libertinus {
						padding: 0 !important;
						display: block !important;
					}
					main {
						box-shadow: none !important;
						border: none !important;
						width: 100% !important;
						padding: 0 !important;
						min-height: auto !important;
					}
					#download-pdf { display: none !important; }
				}
			</style>
		</head>
		<body class="libertinus">
			<button id="download-pdf">Download PDF</button>
			<main>
				@templ.Raw(string(content))
			</main>
			<script>
				const ws = new WebSocket("ws://" + window.location.host + "/ws");
				ws.onmessage = function(event) {
					if (event.data === "reload") window.location.reload();
				};
				ws.onclose = function() {
					setTimeout(() => window.location.reload(), 2000);
				};

				const btn = document.getElementById('download-pdf');
				btn.addEventListener('click', () => {
					btn.disabled = true;
					btn.textContent = 'Generating…';
					// Navigate to /pdf — server returns attachment, page stays loaded.
					const a = document.createElement('a');
					a.href = '/pdf';
					a.click();
					setTimeout(() => {
						btn.disabled = false;
						btn.textContent = 'Download PDF';
					}, 4000);
				});
			</script>
		</body>
	</html>
}
