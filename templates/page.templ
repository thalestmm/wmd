package templates

import "html/template"

templ Page(content template.HTML) {
	<!DOCTYPE html>
	<html lang="en">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>wmd - Preview</title>
			<link rel="stylesheet" href="https://latex.now.sh/style.css"/>
			<script>
				MathJax = {
					startup: { typeset: false },
					tex: {
						inlineMath: [['$', '$'], ['\\(', '\\)']],
						displayMath: [['$$', '$$'], ['\\[', '\\]']],
						processEscapes: true
					}
				};
			</script>
			<script id="MathJax-script" async src="https://cdn.jsdelivr.net/npm/mathjax@3/es5/tex-mml-chtml.js"></script>
			<style>
				html, body {
					margin: 0;
					padding: 0;
					background: #404040;
					min-height: 100vh;
				}
				body.libertinus {
					max-width: none;
					padding: 2.5rem 0;
					display: flex;
					flex-direction: column;
					align-items: center;
				}
				main {
					background: #fff;
					width: 210mm;
					min-height: 297mm;
					padding: 25mm 20mm;
					box-sizing: border-box;
					box-shadow: 0 4px 20px rgba(0,0,0,0.5), 0 1px 4px rgba(0,0,0,0.3);
					border: 1px solid #222;
					margin: 0 auto;
					font-size: 11pt;
					line-height: 1.6;
				}
				main p {
					text-align: justify;
				}
				figure.mermaid-figure {
					margin: 1.7em 0;
					padding: 1.25em 0.55em 1.05em;
					background:
						linear-gradient(#c9d0d8, #c9d0d8) 0 0 / 100% 1px no-repeat,
						linear-gradient(#c9d0d8, #c9d0d8) 0 100% / 100% 1px no-repeat,
						#f8fafb;
					overflow: visible;
				}
				figure.mermaid-figure pre.mermaid {
					margin: 0;
					padding: 0;
					border: none;
					background: transparent;
					box-shadow: none;
					overflow: visible;
					text-align: center;
					font-family: inherit;
					font-size: inherit;
					line-height: inherit;
					white-space: pre;
				}
				figure.mermaid-figure svg {
					max-width: 100%;
					height: auto;
					overflow: visible;
				}
				figure.mermaid-figure .error-icon + text,
				figure.mermaid-figure .error-text {
					font-family: ui-monospace, "SF Mono", Menlo, monospace;
					font-size: 0.82em;
				}
				#download-pdf {
					position: fixed;
					top: 1rem;
					right: 1rem;
					padding: 0.45rem 1rem;
					background: #1a73e8;
					color: #fff;
					border: none;
					border-radius: 4px;
					font-size: 0.82rem;
					font-family: sans-serif;
					cursor: pointer;
					box-shadow: 0 2px 8px rgba(0,0,0,0.35);
					z-index: 1000;
					transition: background 0.15s;
				}
				#download-pdf:hover  { background: #1558b0; }
				#download-pdf:disabled { background: #777; cursor: wait; }
				@page {
					margin: 20mm;
				}
				@media print {
					html, body {
						background: white !important;
					}
					body.libertinus {
						padding: 0 !important;
						display: block !important;
					}
					main {
						box-shadow: none !important;
						border: none !important;
						width: 100% !important;
						padding: 0 !important;
						min-height: auto !important;
					}
					#download-pdf { display: none !important; }
					h1, h2, h3 {
						break-after: avoid;
					}
					figure.mermaid-figure {
						break-inside: avoid;
						page-break-inside: avoid;
						background: none;
						padding: 0.4em 0;
						overflow: visible;
					}
				}
			</style>
		</head>
		<body class="libertinus">
			<button id="download-pdf">Download PDF</button>
			<main>
				@templ.Raw(string(content))
			</main>
			<script src="https://cdn.jsdelivr.net/npm/mermaid@11/dist/mermaid.min.js"></script>
			<script>
				const ws = new WebSocket("ws://" + window.location.host + "/ws");
				ws.onmessage = function(event) {
					if (event.data === "reload") window.location.reload();
				};
				ws.onclose = function() {
					setTimeout(() => window.location.reload(), 2000);
				};

				const btn = document.getElementById('download-pdf');
				btn.addEventListener('click', () => {
					btn.disabled = true;
					btn.textContent = 'Generating…';
					// Navigate to /pdf — server returns attachment, page stays loaded.
					const a = document.createElement('a');
					a.href = '/pdf';
					a.click();
					setTimeout(() => {
						btn.disabled = false;
						btn.textContent = 'Download PDF';
					}, 4000);
				});

				// Freeze SVG layout size in mm. Transform scale is ignored by Chrome print pagination.
				function fitMermaidToPage() {
					const pxPerMm = 96 / 25.4;
					const maxHmm = 232;
					document.querySelectorAll('figure.mermaid-figure').forEach(function (figure) {
						const svg = figure.querySelector('svg');
						if (!svg) return;
						const vb = svg.viewBox && svg.viewBox.baseVal;
						if (vb && vb.width && vb.height) {
							const pad = Math.max(vb.height * 0.04, 16);
							svg.setAttribute('viewBox',
								vb.x + ' ' + (vb.y - pad * 0.1) + ' ' + vb.width + ' ' + (vb.height + pad));
						}
						svg.removeAttribute('width');
						svg.removeAttribute('height');
						svg.style.maxWidth = '100%';
						svg.style.maxHeight = 'none';
						svg.style.width = '100%';
						svg.style.height = 'auto';
						const box = svg.getBoundingClientRect();
						if (!box.width || !box.height) return;
						const maxWmm = Math.max(figure.clientWidth / pxPerMm, 1);
						const scale = Math.min(1, maxWmm / (box.width / pxPerMm), maxHmm / (box.height / pxPerMm));
						svg.style.width = ((box.width / pxPerMm) * scale) + 'mm';
						svg.style.height = ((box.height / pxPerMm) * scale) + 'mm';
					});
				}

				(async function renderDiagrams() {
					try {
						if (window.mermaid) {
							mermaid.initialize({
								startOnLoad: false,
								securityLevel: 'strict',
								theme: 'base',
								look: 'classic',
								fontFamily: 'Libertinus Serif, "Linux Libertine", Georgia, "Times New Roman", serif',
								themeVariables: {
									darkMode: false,
									background: '#f8fafb',
									fontFamily: 'Libertinus Serif, "Linux Libertine", Georgia, "Times New Roman", serif',
									fontSize: '16px',
									textColor: '#1c1917',
									lineColor: '#334155',
									primaryColor: '#f3f6f9',
									primaryTextColor: '#1c1917',
									primaryBorderColor: '#243f5c',
									secondaryColor: '#f3eee4',
									secondaryTextColor: '#1c1917',
									secondaryBorderColor: '#8a7355',
									tertiaryColor: '#fbfbfb',
									tertiaryTextColor: '#1c1917',
									tertiaryBorderColor: '#c5c0b8',
									mainBkg: '#f3f6f9',
									nodeBorder: '#243f5c',
									clusterBkg: '#f4efe6',
									clusterBorder: '#a89478',
									titleColor: '#1c1917',
									edgeLabelBackground: '#f8fafb',
									nodeTextColor: '#1c1917',
									defaultLinkColor: '#334155',
									arrowheadColor: '#334155',
									labelBoxBkgColor: '#ffffff',
									labelBoxBorderColor: '#243f5c',
									labelTextColor: '#1c1917'
								},
								themeCSS: [
									'.node rect,.node circle,.node ellipse,.node polygon,.node path{stroke-width:1.5px;}',
									'.edgePath .path,.flowchart-link{stroke-width:1.4px;}',
									'.cluster rect{stroke-width:1.1px;}',
									'.cluster-label,.cluster span{font-style:italic;}'
								].join(''),
								flowchart: {
									htmlLabels: true,
									curve: 'basis',
									padding: 14,
									nodeSpacing: 28,
									rankSpacing: 48,
									diagramPadding: 6,
									wrappingWidth: 240,
									subGraphTitleMargin: { top: 8, bottom: 10 },
									useMaxWidth: true
								}
							});
							const nodes = document.querySelectorAll('pre.mermaid');
							if (nodes.length) {
								await mermaid.run({ nodes: nodes });
								await new Promise(function (resolve) {
									requestAnimationFrame(function () { requestAnimationFrame(resolve); });
								});
							}
						}
						if (document.fonts && document.fonts.ready) {
							await document.fonts.ready;
						}
						fitMermaidToPage();
						await new Promise(function (resolve) {
							const started = Date.now();
							(function wait() {
								if (window.MathJax && MathJax.typesetPromise) {
									MathJax.typesetPromise().then(resolve).catch(resolve);
									return;
								}
								if (Date.now() - started > 20000) {
									resolve();
									return;
								}
								requestAnimationFrame(wait);
							})();
						});
					} finally {
						document.documentElement.setAttribute('data-wmd-ready', 'true');
					}
				})();
			</script>
		</body>
	</html>
}
